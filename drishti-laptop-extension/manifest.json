{
  "key": "",
  "manifest_version": 3,
  "name": "Daily Vehicle Report \u2013 Drishti link",
  "version": "1.0.0",
  "description": "Sends the DC gate log (Drishti Vehicle Summary, read with your own sign-in) to your Daily Vehicle Report app every 3 minutes, encrypted.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.meradmart.com/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drishti \u2192 Daily Vehicle Report"
  }
}