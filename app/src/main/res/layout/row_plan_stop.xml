<?xml version="1.0" encoding="utf-8"?>
<!-- A store on a planned vehicle: code and name, city / region / sheet note, and its volume on this vehicle. Tap to correct. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/psName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_semibold"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/psPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/faint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/psVol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/jakarta_bold"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <!-- Opens the store's pin in Google Maps (shown when the store's place is known) -->
    <ImageView
        android:id="@+id/psPin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/plan_open_in_maps"
        android:padding="6dp"
        android:src="@drawable/ic_pin"
        android:visibility="gone"
        app:tint="@color/emerald" />
</LinearLayout>
