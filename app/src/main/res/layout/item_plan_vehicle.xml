<?xml version="1.0" encoding="utf-8"?>
<!-- One planned vehicle: size, how full, and the stores it goes to. Long-press to pick it for clubbing. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pvNo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/avatar_bg"
                android:backgroundTint="@color/brand_light"
                android:fontFamily="@font/jakarta_bold"
                android:gravity="center"
                android:textColor="@color/emerald"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_extrabold"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <!-- Capacity, load, stops, trip km as small pills -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/pvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="4dp" />
            </LinearLayout>

            <!-- Main store's total volume today (big, bold), with the fill % under it -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pvStoreVol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bricolage_extrabold"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/pvStoreVolLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/pv_store_total"
                    android:textColor="@color/muted"
                    android:textSize="10.5sp" />

                <!-- Clubbed vehicles: everything on the vehicle together -->
                <TextView
                    android:id="@+id/pvClubTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/jakarta_bold"
                    android:textColor="@color/wait"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pvFill"
                    style="@style/StatusPill" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pvBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:indicatorColor="@color/emerald"
            app:trackColor="@color/brand_light"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <!-- One box per city on this vehicle: total volume and vehicles going (direct / clubbed) -->
        <LinearLayout
            android:id="@+id/pvCities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/pvStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/pvFoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pvClubTag"
                style="@style/StatusPill"
                android:text="@string/plan_clubbed" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pvRoute"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_route_maps"
                android:visibility="gone"
                app:icon="@drawable/ic_route" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pvSplit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_split" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
