<?xml version="1.0" encoding="utf-8"?>
<!-- Replacement block of a Today row: inflated only for the rows that have a replacement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="@color/soft"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    >

    <TextView
        android:id="@+id/replTitle"
        style="@style/Meta"
        android:fontFamily="@font/jakarta_semibold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/replPlate"
                style="@style/Plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/replMeta"
                style="@style/Meta" />

            <TextView
                android:id="@+id/replGateTimes"
                style="@style/Meta"
                android:fontFamily="@font/jakarta_semibold"
                android:maxLines="2"
                android:textColor="@color/ok"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/replPill"
                style="@style/StatusPill" />

            <TextView
                android:id="@+id/replTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/jakarta_semibold"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/replCall"
                style="@style/RoundIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/call"
                android:visibility="gone"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_phone" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/replGate"
        layout="@layout/gate_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>
