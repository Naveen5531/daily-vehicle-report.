<?xml version="1.0" encoding="utf-8"?>
<!-- "By vendor" card on the Today tab: done / total and a progress bar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/vendorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_semibold"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/vendorCount"
            style="@style/Figure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/vendorBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:indicatorColor="@color/emerald"
            app:trackColor="#E7EEEA"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
