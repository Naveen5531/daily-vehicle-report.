<?xml version="1.0" encoding="utf-8"?>
<!-- DMart Drishti inside the app: sign in once, then Pull now reads the gate's vehicle log. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drishtiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drishtiBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/drishti_back"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_extrabold"
                android:text="@string/drishti_title"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/drishtiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drishtiPull"
            style="@style/DButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/drishti_pull" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drishtiMore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="@string/drishti_more"
            android:text="⋮"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/drishtiProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:visibility="invisible" />

    <WebView
        android:id="@+id/drishtiWeb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
