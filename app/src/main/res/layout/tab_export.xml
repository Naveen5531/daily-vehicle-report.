<?xml version="1.0" encoding="utf-8"?>
<!-- Export tab, in the order the work is done: reports and mail first, then the account, tools, security and data. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- 1. Reports -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/excel_reports" />

        <include android:id="@+id/repDaily" layout="@layout/report_card" />
        <include android:id="@+id/repDetails" layout="@layout/report_card" />
        <include android:id="@+id/repSummary" layout="@layout/report_card" />
        <include android:id="@+id/repLog" layout="@layout/report_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportMail"
            style="@style/DButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/export_mail_button"
            app:icon="@drawable/ic_mail" />

        <!-- 3. Tools -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/tools_section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportUpdate"
            style="@style/DOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="Check for app update" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportSpeed"
            style="@style/DOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:text="Speed report (what is slow)" />

        <!-- 4. Security -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/security" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/lockSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/lock_switch" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/secureSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/secure_switch" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:padding="8dp"
                    android:text="@string/security_note"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Data (last, and the only destructive action on this tab) -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/data" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            style="@style/DOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/clear_entries"
            android:textColor="@color/no" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
