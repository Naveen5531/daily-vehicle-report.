<?xml version="1.0" encoding="utf-8"?>
<!-- Yet to report / Reported / Departed: one tap marks the vehicle; tapping the chosen one again clears it.
     Plain text boxes (not Material buttons): the buttons' corner paths were recomputed on every draw and made the lists hang. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gateGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/gateYet"
        style="@style/GateSeg"
        android:layout_weight="1.15"
        android:text="@string/gate_yet" />

    <TextView
        android:id="@+id/gateReported"
        style="@style/GateSeg"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:text="@string/gate_reported" />

    <TextView
        android:id="@+id/gateDeparted"
        style="@style/GateSeg"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:text="@string/gate_departed" />
</LinearLayout>
